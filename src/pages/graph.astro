---
import Base from '../layouts/Base.astro';
import { LAYOUTS } from '../lib/graph-layouts.mjs';
import { href, loadBundle, titleOf } from '../lib/lokf';
const { concepts } = await loadBundle();
const issues = concepts.filter(c => c.data.type === 'Issue')
  .sort((a, b) => String(b.data.issue_date).localeCompare(String(a.data.issue_date)) || a.id.localeCompare(b.id));
const topics = concepts.filter(c => c.data.type === 'Theme').sort((a, b) => titleOf(a).localeCompare(titleOf(b)));
const latest = issues[0]?.id ?? topics[0]?.id ?? concepts[0]?.id ?? '';
---

<Base
  title="Knowledge graph — Innermost Loop Kb"
  description="Explore one article or topic at a time, with connections to its people, systems, and ideas."
  wide
>
  <h1>Knowledge graph</h1>
  <p class="tagline">
    Start with the latest article, choose another edition, or follow a topic across articles. Click a node to inspect it.
    Raw data: <a href={href('/graph.json')}><code>graph.json</code></a> ·
    <a href={href('/graph.jsonld')}><code>graph.jsonld</code></a>.
  </p>

  <div class="lokf-graph" data-graph-base={href('/graph-data/')} data-latest={latest}>
    <div class="lokf-graph__controls">
      <div class="lokf-graph__selectors">
        <label>Article
          <select class="lokf-graph__article" aria-label="Article">
            <option value="">Choose an article…</option>
            {issues.map(c => <option value={c.id} selected={c.id === latest}>{titleOf(c)}</option>)}
          </select>
        </label>
        <label>Topic
          <select class="lokf-graph__topic" aria-label="Topic">
            <option value="">Choose a topic…</option>
            {topics.map(c => <option value={c.id}>{titleOf(c)}</option>)}
          </select>
        </label>
        <button type="button" class="lokf-graph__btn" data-action="latest">Latest article</button>
      </div>
      <div class="lokf-graph__pagination">
        <button type="button" class="lokf-graph__btn" data-action="previous" disabled>← Previous</button>
        <p class="lokf-graph__status" role="status" aria-live="polite">Loading latest article…</p>
        <button type="button" class="lokf-graph__btn" data-action="next" disabled>Next →</button>
      </div>
      <input
        type="search"
        class="lokf-graph__search"
        placeholder="Highlight nodes in this view…"
        aria-label="Highlight nodes in this view"
        autocomplete="off"
      />
      <div class="lokf-graph__filters">
        <fieldset class="lokf-graph__fieldset" data-filter="type">
          <legend>Node types</legend>
        </fieldset>
        <fieldset class="lokf-graph__fieldset" data-filter="predicate">
          <legend>Relations</legend>
        </fieldset>
      </div>
    </div>
    <div class="lokf-graph__view-controls" role="group" aria-label="Graph presentation">
      <button type="button" data-view="graph" aria-pressed="true">Graph</button>
      <button type="button" data-view="list" aria-pressed="false">List</button>
      <button type="button" data-action="reset-filters">Reset filters and search</button>
    </div>
    <details class="lokf-graph__sharing"><summary>Share this view</summary><button type="button" data-action="share">Copy view link</button><label>View link<input type="text" readonly data-share-url /></label><p data-share-status role="status"></p><p>The link restores scope, filters, layout, and selection. Positions may vary; links follow the current knowledge base, not an immutable snapshot.</p></details>
    <details class="lokf-graph__group-browser" hidden><summary>Inspect groups and their members</summary><section class="lokf-graph__groups" aria-label="Groups in this view"></section></details>
    <p class="lokf-graph__scope-note">This is one page of a scoped graph. Communities are inferred from the current page and filters, not established categories. Radial centers show visible connection counts, not global importance.</p>
    <p class="lokf-graph__matches" role="status"></p>
    <section class="lokf-graph__list" aria-label="Concepts in this view" hidden><ul></ul></section>
    <div class="lokf-graph__stage">
      <div class="lokf-graph__toolbar">
        <button type="button" class="lokf-graph__btn" data-action="layouts" aria-expanded="false" aria-controls="graph-layout-panel">Layout ▾</button>
        <button type="button" class="lokf-graph__btn" data-action="fit" title="Fit graph to view">
          ⤢ Fit
        </button>
        <button
          type="button"
          class="lokf-graph__btn"
          data-action="fullscreen"
          title="Open the full-screen graph browser"
        >
          ⛶ Full screen
        </button>
      </div>
      <div id="graph-layout-panel" class="lokf-graph__layout-panel" hidden>
        <label for="graph-layout">Graph layout</label>
        <select id="graph-layout" aria-describedby="graph-layout-help">
          {Object.entries(LAYOUTS).map(([value, layout]) => <option value={value}>{layout.label}</option>)}
        </select>
        <p id="graph-layout-help"></p>
        <label><input type="checkbox" data-action="edge-labels" /> Show relationship labels</label>
        <button type="button" class="lokf-graph__btn" data-action="rearrange">Rearrange</button>
        <p class="lokf-graph__layout-status" role="status" aria-live="polite"></p>
      </div>
      <div class="lokf-graph__canvas"></div>
      <aside class="lokf-graph__detail" hidden>
        <button type="button" class="lokf-graph__close" aria-label="Close">&times;</button>
        <h3 class="lokf-graph__detail-title"></h3>
        <dl>
          <dt>Type</dt><dd class="lokf-graph__detail-type"></dd>
          <dt>IRI</dt><dd class="lokf-graph__detail-iri lokf-graph__mono"></dd>
        </dl>
        <h4>Connections in this view</h4><ul class="lokf-graph__detail-relations"></ul>
        <a class="lokf-graph__detail-page" href="#">Open page →</a>
        <button type="button" class="lokf-graph__btn" data-action="explore">Explore connections</button>
      </aside>
    </div>
  </div>
</Base>

<script>
  import cytoscape from 'cytoscape';
  import fcose from 'cytoscape-fcose';
  import { readView, writeView } from '../lib/graph-view.mjs';
  import { typeStyle } from '../lib/graph-palette.mjs';
  import { REL_LABEL } from '../lib/relation-labels';
  import { LAYOUTS, validLayout, prepareLayout } from '../lib/graph-layouts.mjs';
  cytoscape.use(fcose);


  function themeColor(name: string, fallback: string): string {
    const v = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
    return v || fallback;
  }

  type Elements = {
    nodes: { data: Record<string, string> }[];
    edges: { data: Record<string, string> }[];
  };

  function init(root: HTMLElement) {
    if (root.dataset.ready) return;
    root.dataset.ready = '1';
    const layoutSelect = root.querySelector<HTMLSelectElement>('#graph-layout')!;
    const layoutButton = root.querySelector<HTMLButtonElement>('[data-action=layouts]')!;
    const layoutPanel = root.querySelector<HTMLElement>('#graph-layout-panel')!;
    layoutButton.addEventListener('click', () => {
      layoutPanel.hidden = !layoutPanel.hidden;
      layoutButton.setAttribute('aria-expanded', String(!layoutPanel.hidden));
      if (!layoutPanel.hidden) layoutSelect.focus();
    });
    layoutPanel.addEventListener('keydown', event => {
      if (event.key === 'Escape') { layoutPanel.hidden = true; layoutButton.setAttribute('aria-expanded', 'false'); layoutButton.focus(); }
    });
    const article = root.querySelector<HTMLSelectElement>('.lokf-graph__article')!;
    const topic = root.querySelector<HTMLSelectElement>('.lokf-graph__topic')!;
    const status = root.querySelector<HTMLElement>('.lokf-graph__status')!;
    const previous = root.querySelector<HTMLButtonElement>('[data-action="previous"]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-action="next"]')!;
    let active = root.dataset.latest!;
    let page = 1;
    let cleanup: (() => void) | undefined;
    let request: AbortController | undefined;
    async function load(id: string, wantedPage = 1, historyMode = 'push') {
      request?.abort();
      const controller = new AbortController();
      request = controller;
      if (id !== active && historyMode !== 'none') { const url = new URL(location.href); url.searchParams.delete('node'); history.replaceState({}, '', url); }
      active = id;
      page = wantedPage;
      previous.disabled = next.disabled = true;
      status.textContent = 'Loading graph…';
      root.dataset.state = 'loading';
      cleanup?.();
      cleanup = undefined;
      root.querySelector<HTMLElement>('.lokf-graph__detail')!.hidden = true;
      article.value = id.startsWith('issues/') ? id : '';
      topic.value = id.startsWith('themes/') ? id : '';
      try {
        const path = id.split('/').map(encodeURIComponent).join('/');
        const response = await fetch(`${root.dataset.graphBase}${path}/${wantedPage}.json`, { signal: controller.signal });
        if (!response.ok) throw new Error('This article, topic, or page is unavailable. Choose another or return to the latest article.');
        const graph = await response.json();
        if (controller.signal.aborted) return;
        const scope = graph.scope;
        cleanup = render(root, graph, id);
        root.dataset.state = 'ready';
        root.dataset.nodeCount = String(graph.nodes.length);
        root.dataset.scope = scope.id;
        status.textContent = `${scope.title} · ${scope.start}–${scope.end} of ${scope.total} ${['Issue', 'Theme'].includes(scope.type) ? 'developments' : 'connections'} · ${graph.nodes.length} nodes` +
          (scope.pages > 1 ? ` · Page ${scope.page} of ${scope.pages}` : '') +
          (scope.omitted ? ` · ${scope.omitted} additional context nodes omitted; open a node’s neighborhood to explore further.` : '');
        previous.disabled = scope.page <= 1;
        next.disabled = scope.page >= scope.pages;
        const url = new URL(location.href);
        url.searchParams.set('focus', id);
        if (page > 1) url.searchParams.set('page', String(page));
        else url.searchParams.delete('page');
        if (historyMode !== 'none') history[historyMode === 'replace' ? 'replaceState' : 'pushState']({}, '', url);
      } catch (error) {
        if (controller.signal.aborted) return;
        root.dataset.state = 'error';
        root.querySelector<HTMLElement>('.lokf-graph__canvas')!.textContent = '';
        status.textContent = `Could not load graph. ${error instanceof Error ? error.message : error}`;
      }
    }
    function fromURL(mode = 'none') {
      const params = new URLSearchParams(location.search);
      let saved = '';
      try { saved = localStorage.getItem('iml-graph-layout') || ''; } catch { /* Storage can be disabled. */ }
      layoutSelect.value = validLayout(params.get('layout') || saved);
      const value = Number(params.get('page') || 1);
      load(params.get('focus') || root.dataset.latest!, Number.isSafeInteger(value) && value > 0 ? value : 1, mode);
    }
    article.addEventListener('change', () => { if (article.value) load(article.value); });
    topic.addEventListener('change', () => { if (topic.value) load(topic.value); });
    previous.addEventListener('click', () => load(active, page - 1));
    next.addEventListener('click', () => load(active, page + 1));
    root.querySelector('[data-action="latest"]')!.addEventListener('click', () => load(root.dataset.latest!));
    root.addEventListener('explore-node', (event) => load((event as CustomEvent).detail));
    window.addEventListener('popstate', () => fromURL());
    fromURL('replace');
  }

  function render(root: HTMLElement, graph: Elements, focusId: string) {
    const listeners = new AbortController();
    const layoutSelect = root.querySelector<HTMLSelectElement>('#graph-layout')!;
    const layoutStatus = root.querySelector<HTMLElement>('.lokf-graph__layout-status')!;
    const help = root.querySelector<HTMLElement>('#graph-layout-help')!;
    const edgeLabels = root.querySelector<HTMLInputElement>('[data-action=edge-labels]')!;
    let layoutFrame = 0;
    let currentLayout: any;
    let disposed = false;
    const mount = root.querySelector('.lokf-graph__canvas') as HTMLElement;
    const list = root.querySelector<HTMLElement>('.lokf-graph__list')!;
    const matches = root.querySelector<HTMLElement>('.lokf-graph__matches')!;
    const initial = readView(new URLSearchParams(location.search));
    let selected = initial.selected;
    let view = initial.view;
    edgeLabels.checked = initial.labels;
    function saveView(push = false) {
      const url = writeView(new URL(location.href), {view,query:root.querySelector<HTMLInputElement>('.lokf-graph__search')!.value,selected,hiddenTypes:[...root.querySelectorAll<HTMLInputElement>('[data-filter=type] input:not(:checked)')].map(i=>i.value),hiddenRelations:[...root.querySelectorAll<HTMLInputElement>('[data-filter=predicate] input:not(:checked)')].map(i=>i.value),labels:edgeLabels.checked});
      if(url.href !== location.href) history[push ? 'pushState' : 'replaceState']({},'',url);
      root.querySelector<HTMLInputElement>('[data-share-url]')!.value=url.href;
    }
    function setView(value: string, persist = true) {
      view = value; root.dataset.view = value;
      root.querySelectorAll<HTMLButtonElement>('[data-view]').forEach(button => button.setAttribute('aria-pressed', String(button.dataset.view === view)));
      mount.hidden = view === 'list';
      root.querySelector<HTMLElement>('.lokf-graph__toolbar')!.hidden = view === 'list';
      root.querySelector<HTMLElement>('#graph-layout-panel')!.hidden = true;
      root.querySelector('[data-action=layouts]')!.setAttribute('aria-expanded', 'false');
      updateList();
      if (persist) saveView(true);
      if (view === 'graph') requestAnimationFrame(() => { cy.resize(); cy.fit(); });
    }
    root.querySelectorAll<HTMLButtonElement>('[data-view]').forEach(button => button.addEventListener('click', () => setView(button.dataset.view!), {signal:listeners.signal}));


    const types = [...new Set(graph.nodes.map((n) => n.data.type))].sort();
    const colorOf: Record<string, string> = {};
    types.forEach(t => colorOf[t] = typeStyle(t).color);
    graph.nodes.forEach(n => { n.data.color = typeStyle(n.data.type).color; n.data.shape = typeStyle(n.data.type).shape; });
    root.querySelectorAll('.lokf-graph__fieldset label').forEach(el => el.remove());
    const predicates = [...new Set(graph.edges.map((e) => e.data.predicate))].sort();

    const fg = themeColor('--text', '#333');
    const line = themeColor('--muted', '#888');

    const cy = cytoscape({
      container: mount,
      elements: { nodes: graph.nodes.map(n => ({ ...n, classes: 'concept' })), edges: graph.edges },
      minZoom: 0.2,
      maxZoom: 2.5,
      wheelSensitivity: 0.3,
      layout: { name: 'preset' },
      style: [
        {
          selector: 'node.concept',
          style: {
            'background-color': 'data(color)',
            shape: 'data(shape)',
            label: 'data(label)',
            color: fg,
            'font-size': '11px',
            'text-wrap': 'wrap',
            'text-max-width': '120px',
            'text-valign': 'bottom',
            'text-margin-y': 4,
            width: 26,
            height: 26,
          },
        },
        {
          selector: 'edge',
          style: {
            label: '',
            'font-size': '9px',
            color: line,
            'line-color': line,
            'line-opacity': 0.55,
            'target-arrow-color': line,
            'target-arrow-shape': 'triangle',
            'curve-style': 'bezier',
            width: 1.5,
            'text-rotation': 'autorotate',
          },
        },
        {
          selector: 'node:selected',
          style: { 'border-width': 4, 'border-color': fg },
        },
        { selector: 'edge.show-label', style: { label: 'data(predicate)' } },
        { selector: 'node.layout-group', style: {
          label: 'data(label)', 'font-size': 14, 'font-weight': 'bold', color: fg,
          'text-valign': 'top', 'text-margin-y': -8, 'text-wrap': 'wrap', 'text-max-width': '220px',
          'background-color': line, 'background-opacity': 0.07, 'border-color': line,
          'border-width': 1, 'border-opacity': 0.5, padding: '35px', shape: 'round-rectangle',
        } },
        { selector: '.dim', style: { opacity: 0.15 } },
        { selector: '.hidden', style: { display: 'none' } },
      ],
    });

    function runLayout(persist = false) {
      cancelAnimationFrame(layoutFrame);
      currentLayout?.stop();
      const mode = validLayout(layoutSelect.value);
      help.textContent = LAYOUTS[mode].description;
      layoutStatus.textContent = 'Arranging visible nodes…';
      root.dataset.layoutState = 'loading';
      if (persist) {
        try { localStorage.setItem('iml-graph-layout', mode); } catch { /* Optional preference. */ }
        const url = new URL(location.href);
        url.searchParams.set('layout', mode);
        history.pushState({}, '', url);
        saveView();
      }
      layoutFrame = requestAnimationFrame(() => {
        if (disposed) return;
        try {
          const prepared = prepareLayout(cy, mode);
          renderGroups(mode);
          cy.edges().toggleClass('show-label', edgeLabels.checked);
          if (prepared.nodes) {
            currentLayout = prepared.elements.layout(prepared.options);
            currentLayout.run();
          }
          root.dataset.layout = mode;
          root.dataset.layoutState = 'ready';
          layoutStatus.textContent = prepared.nodes ? `${LAYOUTS[mode].label} · ${prepared.nodes} visible nodes${prepared.groups ? ` · ${prepared.groups} groups` : ''}` : 'No visible nodes. Enable a node type to restore the graph.';
        } catch (error) {
          root.dataset.layoutState = 'error';
          layoutStatus.textContent = 'This layout could not be arranged. Try Classic force or Radial.';
          console.error('Graph layout failed', error);
        }
      });
    }
    layoutSelect.addEventListener('change', () => runLayout(true), { signal: listeners.signal });
    root.querySelector('[data-action=rearrange]')!.addEventListener('click', () => runLayout(), { signal: listeners.signal });
    edgeLabels.addEventListener('change', () => { cy.edges().toggleClass('show-label', edgeLabels.checked); saveView(true); }, { signal: listeners.signal });
    runLayout();

    // Filters: a checkbox per type and per predicate.
    const typeBox = root.querySelector('[data-filter="type"]') as HTMLElement;
    const predBox = root.querySelector('[data-filter="predicate"]') as HTMLElement;
    const checkbox = (value: string, swatch?: string) => {
      const label = document.createElement('label');
      const input = document.createElement('input');
      input.type = 'checkbox';
      input.checked = !(swatch ? initial.hiddenTypes : initial.hiddenRelations).includes(value);
      input.value = value;
      label.append(input);
      if (swatch) {
        const dot = document.createElement('span');
        dot.className = 'lokf-graph__swatch';
        dot.style.background = swatch;
        label.append(dot);
      }
      label.append(document.createTextNode(' ' + (swatch ? `${value} (${typeStyle(value).shape})` : REL_LABEL[value] || value)));
      input.setAttribute('aria-label', swatch ? value : REL_LABEL[value] || value);
      input.addEventListener('change', applyFilters, { signal: listeners.signal });
      return label;
    };
    types.forEach((t) => typeBox.append(checkbox(t, colorOf[t])));
    predicates.forEach((p) => predBox.append(checkbox(p)));

    const checkedValues = (box: HTMLElement) =>
      new Set([...box.querySelectorAll<HTMLInputElement>('input:checked')].map((i) => i.value));
    function applyFilters(persist: unknown = true) {
      const okTypes = checkedValues(typeBox);
      const okPreds = checkedValues(predBox);
      cy.nodes('.concept').forEach((n) => n.toggleClass('hidden', !okTypes.has(n.data('type'))));
      cy.edges().forEach((e) => e.toggleClass('hidden', !okPreds.has(e.data('predicate'))));
      updateList();
      if (persist) saveView(true);
      if (!detail.hidden) { const chosen = cy.nodes('.concept').filter(n => n.data('concept_id') === selected && !n.hasClass('hidden')); if(chosen.length) showDetail(chosen[0].data(), false); else {detail.hidden=true;selected='';saveView();} }
      runLayout();
    }

    // Search dims non-matching nodes.
    const search = root.querySelector('.lokf-graph__search') as HTMLInputElement;
    search.value = initial.query;
    search.addEventListener('input', () => {
      const q = search.value.trim().toLowerCase();
      cy.nodes('.concept').forEach((n) =>
        n.toggleClass('dim', q !== '' && !n.data('label').toLowerCase().includes(q)),
      );
      updateList();
      saveView();
    }, { signal: listeners.signal });

    // Detail panel on node click, linking to the node's page.
    const detail = root.querySelector('.lokf-graph__detail') as HTMLElement;
    const set = (sel: string, text: string) => {
      (root.querySelector(sel) as HTMLElement).textContent = text;
    };
    let returnFocus: HTMLElement | null = null;
    const showDetail = (d: Record<string, string>, persist = true) => {
      selected = d.concept_id;
      if (persist) saveView(true);
      if (detail.hidden) returnFocus = document.activeElement as HTMLElement;
      const relationships = root.querySelector<HTMLElement>('.lokf-graph__detail-relations')!;
      relationships.replaceChildren();
      const visible = new Set(cy.nodes('.concept').not('.hidden').map(n => n.id()));
      for (const edge of cy.edges().not('.hidden')) {
        const e = edge.data();
        if (!visible.has(e.source) || !visible.has(e.target) || (e.source !== d.id && e.target !== d.id)) continue;
        const other = cy.getElementById(e.source === d.id ? e.target : e.source).data();
        const li = document.createElement('li');
        const button = document.createElement('button'); button.textContent = other.label;
        button.addEventListener('click', () => showDetail(other));
        li.append(`${e.target === d.id ? 'Incoming: ' : ''}${REL_LABEL[e.predicate] || e.predicate}: `, button);
        relationships.append(li);
      }
      if (!relationships.childElementCount) relationships.textContent = 'No connections under the current filters.';
      set('.lokf-graph__detail-title', d.label);
      set('.lokf-graph__detail-type', d.type);
      set('.lokf-graph__detail-iri', d.id);
      (root.querySelector('.lokf-graph__detail-page') as HTMLAnchorElement).href = d.href;
      const explore = root.querySelector<HTMLButtonElement>('[data-action=explore]')!;
      explore.onclick = () => root.dispatchEvent(new CustomEvent('explore-node', { detail: d.concept_id }));
      detail.hidden = false;
      root.querySelector<HTMLButtonElement>('.lokf-graph__close')!.focus();
    };
    cy.on('tap', 'node.concept', (evt) => showDetail(evt.target.data()));
    (root.querySelector('.lokf-graph__close') as HTMLElement).addEventListener(
      'click',
      () => { detail.hidden = true; selected='';saveView(true); if (returnFocus?.isConnected) returnFocus.focus(); },
      { signal: listeners.signal },
    );

    detail.addEventListener('keydown', event => { if (event.key === 'Escape') root.querySelector<HTMLButtonElement>('.lokf-graph__close')!.click(); }, {signal:listeners.signal});
    function updateList() {
      const q = root.querySelector<HTMLInputElement>('.lokf-graph__search')!.value.trim().toLowerCase();
      const nodes = cy.nodes('.concept').not('.hidden').filter(n => !q || n.data('label').toLowerCase().includes(q));
      list.hidden = view !== 'list' && !q;
      matches.textContent = `${nodes.length} ${q ? 'matching' : 'visible'} concepts in this page${nodes.length ? '' : '. Reset filters or search to see concepts.'}`;
      const ul = list.querySelector('ul')!; ul.replaceChildren();
      for (const node of nodes) {
        const d = node.data(); const li = document.createElement('li');
        const button = document.createElement('button'); button.textContent = d.label;
        button.addEventListener('click', () => showDetail(d));
        const metadata = document.createElement('small'); metadata.textContent = ` ${d.type} · ${d.date ? 'Reported ' + d.date : 'Reporting date unknown'}`;
        li.append(button, metadata); ul.append(li);
      }
    }
    root.querySelector('[data-action=reset-filters]')!.addEventListener('click', () => {
      root.querySelectorAll<HTMLInputElement>('.lokf-graph__fieldset input').forEach(input => input.checked = true);
      search.value = initial.query; cy.nodes().removeClass('dim'); applyFilters();
    }, {signal:listeners.signal});
    root.querySelector('[data-action=share]')!.addEventListener('click', async () => {
      saveView();const input=root.querySelector<HTMLInputElement>('[data-share-url]')!;
      try { await navigator.clipboard.writeText(input.value); root.querySelector('[data-share-status]')!.textContent='View link copied.'; }
      catch {input.focus();input.select();root.querySelector('[data-share-status]')!.textContent='Copy the selected view link.';}
    }, {signal:listeners.signal});
    function renderGroups(mode: string) {
      const region=root.querySelector<HTMLElement>('.lokf-graph__groups')!;region.replaceChildren();
      region.hidden=!['communities','types'].includes(mode);
      root.querySelector<HTMLElement>('.lokf-graph__group-browser')!.hidden=region.hidden;
      if(region.hidden)return;
      const heading=document.createElement('h2');heading.textContent='Groups in this view';region.append(heading);
      for(const group of cy.nodes('.layout-group')) {
        const members=group.children('.concept').not('.hidden');
        const edges=cy.edges().not('.hidden').filter(e=>members.contains(e.source()) && members.contains(e.target()));
        const details=document.createElement('details'),summary=document.createElement('summary'),list=document.createElement('ul');
        summary.textContent=`${group.data('label')} · ${members.length} concepts · ${edges.length} visible internal relationships`;
        for(const n of members){const li=document.createElement('li'),button=document.createElement('button');button.textContent=n.data('label');button.addEventListener('click',()=>showDetail(n.data()));li.append(button);list.append(li);}
        const note=document.createElement('p');note.textContent=mode==='communities'?'Inferred on this page using non-membership relationships. Counts include all visible internal relationships; open a member to inspect its connections.':'Grouped by stored concept type. Open a member to inspect its connections.';
        details.append(summary,note,list);region.append(details);
      }
    }
    applyFilters(false);
    cy.nodes('.concept').forEach(n=>n.toggleClass('dim', !!search.value && !n.data('label').toLowerCase().includes(search.value.toLowerCase())));
    setView(view, false);
    const restored=cy.nodes('.concept').filter(n=>n.data('concept_id')===selected && !n.hasClass('hidden'));
    if(restored.length) showDetail(restored[0].data(), false);
    else selected='';
    root.querySelector<HTMLInputElement>('[data-share-url]')!.value=location.href;

    const fit = () => { const visible = cy.elements(':visible'); if (visible.nodes().length) cy.fit(visible, 45); };

    // Keep the entire bounded scope visible; selecting an issue must not
    // zoom so far into its center that all its developments disappear.
    const frame = requestAnimationFrame(() => { cy.resize(); });
    const target = cy.nodes().filter(n => n.data('concept_id') === focusId);
    target.select();

    // Toolbar: fit + a full-screen graph browser.
    const stage = root.querySelector('.lokf-graph__stage') as HTMLElement;
    root.querySelector('[data-action="fit"]')!.addEventListener('click', fit, { signal: listeners.signal });
    const fsBtn = root.querySelector('[data-action="fullscreen"]') as HTMLButtonElement;
    fsBtn.addEventListener('click', () => {
      if (document.fullscreenElement) document.exitFullscreen();
      else stage.requestFullscreen?.();
    }, { signal: listeners.signal });
    document.addEventListener('fullscreenchange', () => {
      const full = document.fullscreenElement === stage;
      stage.classList.toggle('is-fullscreen', full);
      fsBtn.textContent = full ? '⛶ Exit full screen' : '⛶ Full screen';
      requestAnimationFrame(() => {
        cy.resize();
        fit();
      });
    }, { signal: listeners.signal });
    return () => { disposed = true; cancelAnimationFrame(frame); cancelAnimationFrame(layoutFrame); currentLayout?.stop(); listeners.abort(); cy.destroy(); };
  }

  document.querySelectorAll<HTMLElement>('.lokf-graph').forEach(init);
</script>

